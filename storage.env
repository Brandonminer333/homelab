# Host storage layout for every stack. Tracked in git: these are host paths,
# not secrets. Not named `.env` because .gitignore excludes that everywhere.
#
# Applied automatically on deploy — src/ci-cd/watchtower/git-sync.sh passes this
# file to every stack as an extra --env-file, ahead of the stack's own .env.
#
# Manual use, from a stack directory two levels down (src/nextcloud, …):
#   docker compose --env-file ../../storage.env --env-file .env up -d
# Three levels down (src/media/*, src/network/*, src/ci-cd/*):
#   docker compose --env-file ../../../storage.env up -d
#
# After changing a path here: move the data, run scripts/init-storage.sh, commit.

# 1 TB HDD, ext4, mounted by /etc/fstab. Holds all persistent service state.
DATA_ROOT=/mnt/homelab-data

# Bulk read-only libraries (video, music). Split these onto another disk later
# by editing only this line.
MEDIA_ROOT=/mnt/homelab-data/media
