.env
__pycache__/
.git-sync-status

# Persistent service data lives outside the repo, under the DATA_ROOT set in
# storage.env. Nothing to ignore here; scripts/init-storage.sh creates the tree.

src/homepage/config/logs/** # Homepage runtime logs — keep directory via .gitkeep
!src/homepage/config/logs/
!src/homepage/config/logs/.gitkeep
