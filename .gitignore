.env
__pycache__/

src/Sanguine/media/ # media files are not tracked, too big
src/Clavicus Vile/data/ # torrent downloads are not tracked, too big

minecraft/mc-data/** # world saves / server data — keep directory via .gitkeep
!minecraft/mc-data/.gitkeep

src/gitea/data/** # repos / app data — keep directory via .gitkeep
!src/gitea/data/.gitkeep
src/gitea/postgres/** # database — keep directory via .gitkeep
!src/gitea/postgres/.gitkeep
