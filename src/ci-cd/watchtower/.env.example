# Host-only settings for the watchtower stack. Not used for which apps run —
# that lives in the public src/watchtower/config.yml.

# Absolute path to this repo on the Docker host (Lenovo).
# Must be the real clone — bind-mounted so compose reads updated files.
HOMELAB_PATH=/home/branflakes/homelab

# Branch to track
GIT_BRANCH=main

# How often to poll origin (seconds)
POLL_INTERVAL=300

# Internal ntfy publish URL (git-sync → ntfy on the homelab Docker network).
# NTFY_URL=http://ntfy/homelab
