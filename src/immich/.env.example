# You can find documentation for all Immich env vars at:
#   https://docs.immich.app/install/environment-variables

# Immich uploads / thumbs / encoded video (NOT your Seafile library)
UPLOAD_LOCATION=../../data/immich/library

# Bundled Postgres data (must be local disk, not a network share)
DB_DATA_LOCATION=../../data/immich/postgres

# Seafile desktop-client sync of the Photos library on this host.
# Must contain real image files (JPEG/HEIC/…), not Seafile block storage.
EXTERNAL_LIBRARY_PATH=/home/branflakes/Seafile/Photos

# Pin major line; Watchtower can pull newer v3.x of the app images.
IMMICH_VERSION=v3

TZ=America/Los_Angeles

# Postgres password for the bundled Immich DB only (A-Za-z0-9).
#   pwgen -s 32 1
DB_PASSWORD=

# Defaults — usually leave as-is
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
