# Host user that owns ../../data/navidrome and can read the music library.
# On the host:  id -u <user>  and  id -g <user>
# Must match the owner of ../../data/navidrome/metadata, or Navidrome cannot
# create its SQLite database and exits with "Database could not be opened!".
# Defaults to 1000:1000 if left blank.
PUID=
PGID=
