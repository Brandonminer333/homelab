# Host user that owns $DATA_ROOT/navidrome and can read $MEDIA_ROOT/music
# (both roots are set in storage.env at the repo root).
# On the host:  id -u <user>  and  id -g <user>
# Must match the owner of $DATA_ROOT/navidrome/metadata, or Navidrome cannot
# create its SQLite database and exits with "Database could not be opened!".
# scripts/init-storage.sh applies these values when it creates the tree.
# Defaults to 1000:1000 if left blank.
PUID=
PGID=
