# MariaDB credentials. Baked into the database on first start, so changing them
# later means editing data/nextcloud/html/config/config.php and the DB user too.
#   openssl rand -base64 24
MYSQL_USER=nextcloud
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# First admin account, created only on the very first start.
# Afterwards: docker exec -u www-data nextcloud php occ user:resetpassword USER
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=

# Shared between Euro-Office Document Server and the Nextcloud Office connector.
# At least 32 characters:
#   openssl rand -hex 32
JWT_SECRET=
