MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
# Must include the Tailscale hostname (and port if non-443) it is served under.
NEXTCLOUD_TRUSTED_DOMAINS=lenovoflakes.tail62b305.ts.net:8444
# Subnet nginx connects from on the homelab network.
# Find it with: docker network inspect homelab  (look at IPAM.Config.Subnet)
NEXTCLOUD_TRUSTED_PROXIES=172.20.0.0/16
