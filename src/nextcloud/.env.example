# Postgres credentials. Baked into the database on first start, so changing them
# later means editing data/nextcloud/html/config/config.php and the DB user too.
#   openssl rand -base64 24
NEXTCLOUD_DB_PASSWORD=

# First admin account, created only on the very first start.
# Afterwards: docker exec -u www-data nextcloud php occ user:resetpassword USER
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
