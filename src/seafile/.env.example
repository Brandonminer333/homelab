# Bundled MariaDB root password (first-boot DB/user create).
# INIT_SEAFILE_MYSQL_ROOT_PASSWORD is still accepted as a fallback.
MARIADB_ROOT_PASSWORD=

# Seafile app DB user (created on first boot)
SEAFILE_DB_PASSWORD=

# Generate with: pwgen -s 40 1  (or openssl rand -base64 32)
JWT_PRIVATE_KEY=

INIT_SEAFILE_ADMIN_EMAIL=
INIT_SEAFILE_ADMIN_PASSWORD=

# Hostname as clients see it (include :8444 — nginx TLS port)
SEAFILE_SERVER_HOSTNAME=lenovoflakes.tail62b305.ts.net:8444
