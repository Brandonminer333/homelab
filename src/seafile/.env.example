# Signs internal service tokens — at least 32 characters:
#   openssl rand -hex 32
JWT_PRIVATE_KEY=

# MariaDB credentials. Both are baked into the databases on first start,
# so changing them later means editing conf/seafile.conf and the DB user too.
#   openssl rand -base64 24
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_PASSWORD=
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=

# First admin account, created only on the very first start.
# Afterwards: docker exec -it seafile /opt/seafile/seafile-server-latest/reset-admin.sh
INIT_SEAFILE_ADMIN_EMAIL=
INIT_SEAFILE_ADMIN_PASSWORD=
