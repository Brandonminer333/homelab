# Absolute path to this repo on the Docker host (Lenovo).
# Must be the real clone — bind-mounted so compose reads updated files.
HOMELAB_PATH=/home/branflakes/homelab

# Branch to track
GIT_BRANCH=main

# How often to poll origin (seconds)
POLL_INTERVAL=300

# Optional: space-separated stack dirs relative to HOMELAB_PATH.
# Leave empty to auto-discover every docker-compose.yml except watchtower/.
# Example (nginx last):
# STACKS=src/pihole src/nextcloud src/jellyfin src/qbittorrent src/minecraft minecraft src/llm/mcp/public src/nginx
STACKS=

# Internal ntfy publish URL (git-sync → ntfy on the homelab Docker network).
# NTFY_URL=http://ntfy/homelab
