# Protects https://…:8447/admin
# Prefer an Argon2 hash (recommended):
#   docker run --rm -it vaultwarden/server:1.37.0 /vaultwarden hash
# Paste the full $argon2id$… string below (quote it — shells treat $ specially).
# Plaintext also works (Vaultwarden hashes it on start), e.g.:
#   openssl rand -base64 48
ADMIN_TOKEN=

# Allow account creation until you have registered, then set false and
# `docker compose up -d` again.
SIGNUPS_ALLOWED=true

# Keep false unless you intentionally invite other users from the admin UI.
INVITATIONS_ALLOWED=false
